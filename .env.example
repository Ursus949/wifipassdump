# Copy this file to .env and set WEBHOOK_URL before building.
# The value must be your webhook URL encoded as base64.
# It is embedded in the binary at compile time. No .env file is needed at runtime.
#
# To encode your URL:
#   echo -n "https://discord.com/api/webhooks/..." | base64
#
# To build:
#   cargo build --release

WEBHOOK_URL=
